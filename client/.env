# Leave unset for local dev - Vite's proxy handles "/api" automatically (see vite.config.js).
# Set this only when deploying the frontend to a different domain than the backend,
# e.g. VITE_API_BASE=https://PayMend-server.onrender.com/api
VITE_API_BASE=

# Optional: enables real sign-in via Clerk (https://clerk.com, free tier).
# Leave unset to run with no sign-in gate at all (today's default - matches
# the backend running with no CLERK_SECRET_KEY set). Get a real test
# publishable key from your Clerk dashboard > API Keys once you want the
# dashboard to require a signed-in user.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_cHJvbXB0LXRlYWwtOTU0My5jbGVyay5hY2NvdW50cy5kZXYk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_cHJvbXB0LXRlYWwtOTU0My5jbGVyay5hY2NvdW50cy5kZXYk